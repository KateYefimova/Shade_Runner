; Orbital Outpost demonstration project
config_version=5

[application]
config/name="Orbital Outpost — Asset Demo"
run/main_scene="res://godot-demo/main.tscn"

[display]
window/size/viewport_width=1152
window/size/viewport_height=768
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.063, 0.09, 0.145, 1)
